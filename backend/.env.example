# InkMath Backend Configuration

# Optional: Add any vision LLM API key below to enable real multimodal vision evaluation.
# If left empty, InkMath automatically runs in built-in offline heuristic evaluation mode!

# Google Gemini API Key (defaults to high-quota, fast Flash-Lite model)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest

# OpenAI API Key (e.g. GPT-4o-mini)
# OPENAI_API_KEY=

# OpenRouter API Key
# OPENROUTER_API_KEY=

